# SECURITY
# - Never commit `.env.local`.
# - Treat all values below as secrets unless explicitly public.
# - If exposed, rotate immediately.

# Circle (REQUIRED)
# Create in Circle Console: https://console.circle.com/ under "API & Client Keys" (Type: API Key, Access: Standard Key)
CIRCLE_API_KEY=
# Generate offline as a 32-byte hex string. Register via Circle's registration endpoint before use.
# See: https://developers.circle.com/wallets/dev-controlled/register-entity-secret
# Critical: this is used to authorize developer-controlled wallet signing. Keep server-side only.
CIRCLE_ENTITY_SECRET=
CIRCLE_ENVIRONMENT=sandbox

# Circle Wallets
# PLATFORM_WALLET_* should point to your server/platform wallet in Circle.
PLATFORM_WALLET_ID=
PLATFORM_WALLET_ADDRESS=
OSS_DEPENDENCY_WALLET_ADDRESS=
OSS_DEPENDENCY_WALLET_ID=

# Arc Blockchain
ARC_RPC_URL=https://rpc.arc-testnet.circle.com
ARC_CHAIN_ID=482
ARC_USDC_CONTRACT=0x3600000000000000000000000000000000000000

# x402 Facilitator (thirdweb)
THIRDWEB_SECRET_KEY=

# ERC-8004 Vyper Contract
AGENT_IDENTITY_CONTRACT=
SERVER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# Database
DATABASE_URL=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SESSION_JWT_SECRET=

# AI Inference
# Router behavior:
# - Prefers AIML_API_KEY for AIML provider
# - Prefers FEATHERLESS_API_KEY for Featherless provider
# - Falls back to OPENAI_API_KEY when provider-specific key is missing
OPENAI_API_KEY=
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_API_DEFAULT_MODEL=gpt-4o-mini
FEATHERLESS_API_KEY=
FEATHERLESS_API_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_API_DEFAULT_MODEL=llama-3.1-8b-instruct

# Specialist Swarm Routing
SPECIALIST_SUMMARIZE_ID=
SPECIALIST_ANALYZE_ID=
SPECIALIST_EXTRACT_ID=
SPECIALIST_ELITE_ID=
SPECIALIST_SUMMARIZE_MODEL=llama-3.1-8b-instruct
SPECIALIST_ANALYZE_MODEL=hermes-2-pro-llama-3-8b
SPECIALIST_EXTRACT_MODEL=phi-3-mini-128k
SPECIALIST_ELITE_MODEL=gpt-4o-mini
SPECIALIST_SUMMARIZE_PAYOUT_ADDRESS=
SPECIALIST_ANALYZE_PAYOUT_ADDRESS=
SPECIALIST_EXTRACT_PAYOUT_ADDRESS=
SPECIALIST_ELITE_PAYOUT_ADDRESS=
MIN_SPECIALIST_REPUTATION_SCORE=4.2

# Attestation (Ed25519 keypair)
ATTESTATION_PRIVATE_KEY=
ATTESTATION_PUBLIC_KEY=
ATTESTATION_KEY_FINGERPRINT=
